              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/vuelos/reservas/{{reservaPendienteId}}"
          }
        }
      ],
      "description": "Estos requests fallan si se corren sin preparar el escenario. Excluirlos del Runner automatico."
    }
