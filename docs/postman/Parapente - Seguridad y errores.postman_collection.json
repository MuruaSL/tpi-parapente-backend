            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/vuelos/reservas/revalidacion"
          }
        },
        {
          "name": "MANUAL V5d - la reserva ahora esta CONFIRMADA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Codigo 200', ()=>pm.expect([200]).to.include(pm.response.code));",
                  "pm.test('Estado CONFIRMADA', ()=>pm.expect(pm.response.json().estado).to.eql('CONFIRMADA'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
